        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;arcSize=4;" value="&lt;b&gt;LEGENDA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidade (pé de galinha)&lt;/b&gt;&lt;br&gt;─┼┼─ &amp;nbsp;exatamente um&lt;br&gt;─○┼─ &amp;nbsp;zero ou um&lt;br&gt;─┼&amp;lt; &amp;nbsp;um ou muitos&lt;br&gt;─○&amp;lt; &amp;nbsp;zero ou muitos&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;Amarelo: cadastros de apoio&lt;br&gt;Azul: pessoas (quem usa / quem é atendido)&lt;br&gt;Laranja: fluxo principal da demanda&lt;br&gt;Lilás: registros de acompanhamento e histórico&lt;br&gt;&lt;br&gt;(PK) sublinhado = identificador da entidade" vertex="1">
          <mxGeometry height="260" width="300" x="400" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;size=16;" value="&lt;b&gt;RELACIONAMENTOS NÃO DESENHADOS&lt;/b&gt;&lt;br&gt;(omitidos para não poluir o diagrama)&lt;br&gt;&lt;br&gt;• Usuário 1:N &lt;i&gt;realiza&lt;/i&gt; Encaminhamento&lt;br&gt;• Usuário 1:N &lt;i&gt;registra&lt;/i&gt; Retorno de Acompanhamento&lt;br&gt;• Usuário 1:N &lt;i&gt;registra&lt;/i&gt; Histórico de Demanda&lt;br&gt;• Evolução 0..1 &lt;i&gt;retifica&lt;/i&gt; Evolução (autorrelacionamento: a nova versão aponta para a original)&lt;br&gt;&lt;br&gt;&lt;b&gt;REGRAS IMPORTANTES&lt;/b&gt;&lt;br&gt;• Encaminhamento tem exatamente UM destino: serviço da rede, profissional interno OU destino_livre&lt;br&gt;• Demanda.estado ∈ {aberta, em andamento, aguardando terceiros, concluída, cancelada}&lt;br&gt;• Histórico e Auditoria: somente inserção, nunca alteração ou exclusão&lt;br&gt;• Nenhum registro é excluído: usa-se estado/ativo" vertex="1">
          <mxGeometry height="360" width="330" x="1120" y="1000" as="geometry" />
        </mxCell>
